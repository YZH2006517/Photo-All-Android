<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One fixed dark theme. Not DeviceDefault/DayNight: system dark mode and the
         platform's force-dark must not recolour switches, text or popups. -->
    <style name="FilmTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#161616</item>
        <item name="android:colorAccent">#E0B060</item>
        <item name="android:colorControlActivated">#E0B060</item>
        <item name="android:colorControlNormal">#9A9A9A</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#BBBBBB</item>
        <item name="android:colorButtonNormal">#3A3A3A</item>
        <item name="android:alertDialogTheme">@style/FilmDialog</item>
    </style>

    <style name="FilmDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:colorAccent">#E0B060</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
    </style>
</resources>
