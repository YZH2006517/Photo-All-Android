<?xml version="1.0" encoding="utf-8"?>
<!-- A new screen rises a little and comes up out of the one below. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false" android:zAdjustment="top">
    <translate android:fromYDelta="6%" android:toYDelta="0"
        android:duration="320" android:interpolator="@android:interpolator/decelerate_cubic" />
    <alpha android:fromAlpha="0" android:toAlpha="1"
        android:duration="220" android:interpolator="@android:interpolator/decelerate_quad" />
</set>
