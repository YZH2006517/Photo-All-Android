<?xml version="1.0" encoding="utf-8"?>
<!-- Contact sheet cells settle in one after another. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <translate android:fromYDelta="18%" android:toYDelta="0" android:duration="360" />
    <scale android:fromXScale="0.92" android:toXScale="1" android:fromYScale="0.92" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="360" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="300" />
</set>
