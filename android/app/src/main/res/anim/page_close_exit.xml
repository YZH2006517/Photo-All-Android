<?xml version="1.0" encoding="utf-8"?>
<!-- Back: the top screen sinks away. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false" android:zAdjustment="top">
    <translate android:fromYDelta="0" android:toYDelta="6%"
        android:duration="260" android:interpolator="@android:interpolator/accelerate_cubic" />
    <alpha android:fromAlpha="1" android:toAlpha="0"
        android:duration="260" android:interpolator="@android:interpolator/accelerate_quad" />
</set>
