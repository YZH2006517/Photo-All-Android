<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vulkan 1.1: compute subgroup arithmetic used by filmsim's setup pass -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <!-- only to send a problem report when the user taps 发送给开发者 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 拍摄录屏: the screen through MediaProjection, held by a foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only to list the app's own folder again after its data was cleared or it was
         reinstalled: the system then no longer counts those photos as the app's. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:name=".PhotoAllApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="Photo All"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/FilmTheme"
        android:largeHeap="true">
        <activity
            android:name=".camera.CameraActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:rotationAnimation="jumpcut"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|colorMode|layoutDirection|locale|touchscreen">
        </activity>
        <!-- the first screen: 胶片相机 or 拼贴相机 -->
        <activity android:name=".collage.LaunchActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".collage.CollageHomeActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".collage.StickerMakerActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".collage.StickerLibraryActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".collage.CollageActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".collage.CollageCameraActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".collage.PhotoPickerActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".collage.StickerEditActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".settings.SettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".settings.LogActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".settings.WhatsNewActivity" android:exported="false" android:screenOrientation="portrait"
            android:theme="@style/FilmSeeThrough" />
        <activity android:name=".gallery.TuneActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".settings.GuideActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".gallery.GalleryActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".gallery.ViewerActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".gallery.DevelopShowActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".gallery.LightboxActivity" android:exported="false" android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />
        <activity android:name=".gallery.FrameActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".gallery.EditActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.CameraBackActivity" android:exported="false" android:hardwareAccelerated="true"
            android:screenOrientation="sensorLandscape" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />
        <activity android:name=".ui.ShelfActivity" android:exported="false" android:hardwareAccelerated="true"
            android:screenOrientation="fullUser" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />
        <activity android:name=".ui.Cartridge3DActivity" android:exported="false" android:hardwareAccelerated="true"
            android:screenOrientation="behind" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />
        <activity android:name=".gallery.ImportActivity" android:exported="false" android:screenOrientation="portrait" />
        <!-- the app's own photo folder, for sharing and opening those photos -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="org.photoall.film.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/photo_paths" />
        </provider>
        <!-- compiles the GPU kernels apart from the app first: a driver crash there only ends this process -->
        <service android:name=".reel.Reel$Service" android:foregroundServiceType="mediaProjection" android:exported="false" />
        <service android:name=".engine.GpuProbe$Probe" android:process=":gpuprobe" android:exported="false" />
        <!-- engine test bench; also the adb benchmark entry point -->
        <activity android:name=".MainActivity" android:exported="true" />
    </application>
</manifest>
