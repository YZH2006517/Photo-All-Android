#version 450
// The scanner's last step, on the developed picture (linear Rec.2020): its sharpening (an
// unsharp mask on luminance, so edges gain no colour fringes) and its black and white points.
// The scanner's own softness is the blurred input the engine hands in as img_in.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0) uniform sampler2D img_in;
layout(set = 1, binding = 1) uniform sampler2D img_wide;
layout(set = 1, binding = 2, rgba16f) uniform writeonly restrict image2D img_out;
layout(push_constant) uniform push_t
{
  float sharpen; // unsharp mask amount (0 off)
  float black;   // display level (0..1, a 2.2 curve) that becomes black
  float white;   // display level that becomes white
  float pad;
} push;

float luminance(vec3 rgb) { return dot(rgb, vec3(0.2627, 0.6780, 0.0593)); }

void main()
{
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(img_out);
  if(any(greaterThanEqual(p, size))) return;
  vec4 c = texelFetch(img_in, p, 0);
  vec3 rgb = c.rgb;
  if(push.sharpen > 0.0)
  {
    vec3 w = texture(img_wide, (vec2(p) + 0.5) / vec2(size)).rgb;
    float detail = luminance(rgb) - luminance(w);
    rgb = max(rgb + push.sharpen * detail, vec3(0.0));
  }
  // the levels as one sees them: black and white points on display values (a 2.2 curve),
  // so 0.03 is 3 % grey, not a third of the shadows
  if(push.black > 0.0 || push.white != 1.0)
  {
    vec3 v = pow(max(rgb, vec3(0.0)), vec3(1.0 / 2.2));
    v = max((v - push.black) / max(push.white - push.black, 1e-3), vec3(0.0));
    rgb = pow(v, vec3(2.2));
  }
  imageStore(img_out, p, vec4(max(rgb, vec3(0.0)), c.a));
}
