#version 450
#extension GL_EXT_control_flow_attributes : enable
// HDR+-style robust burst merge in the Bayer domain. Each frame is shifted by its
// tile offset (even pixels, CFA phase kept) and weighted by how well a same-colour
// 3x3 mean agrees with the reference, relative to the sensor noise:
// w = c s^2 / (c s^2 + d^2), the spatial-domain form of HDR+'s merge weight.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0) uniform usampler2D f0;
layout(set = 1, binding = 1) uniform usampler2D f1;
layout(set = 1, binding = 2) uniform usampler2D f2;
layout(set = 1, binding = 3) uniform usampler2D f3;
layout(set = 1, binding = 4) uniform usampler2D f4;
layout(set = 1, binding = 5) uniform usampler2D f5;
layout(set = 1, binding = 6, std430) readonly buffer offsets_t { ivec2 offsets[]; };
layout(set = 1, binding = 7, r32ui) uniform writeonly restrict uimage2D img_out;
layout(push_constant) uniform push_t
{
  vec4  black;      // per 2x2 position
  float white;
  float noise_s;    // variance = s * x + o, x in [0, 1]
  float noise_o;
  float strength;   // c: larger merges more aggressively
  int   frames;
  int   tiles_x;
  int   tiles_y;
  int   tile;
} push;

ivec2 size;

float norm(uint v, ivec2 p)
{
  float black = push.black[(p.x & 1) + 2 * (p.y & 1)];
  return (float(v) - black) / (push.white - black);
}

float sample_frame(int i, ivec2 p)
{
  p = clamp(p, ivec2(p & 1), size - 2 + (p & 1)); // stay on the same CFA colour
  uint v;
  if(i == 0) v = texelFetch(f0, p, 0).r;
  else if(i == 1) v = texelFetch(f1, p, 0).r;
  else if(i == 2) v = texelFetch(f2, p, 0).r;
  else if(i == 3) v = texelFetch(f3, p, 0).r;
  else if(i == 4) v = texelFetch(f4, p, 0).r;
  else v = texelFetch(f5, p, 0).r;
  return norm(v, p);
}

float local_mean(int i, ivec2 p)
{
  float s = 0.0;
  [[unroll]] for(int y = -2; y <= 2; y += 2)
    [[unroll]] for(int x = -2; x <= 2; x += 2) s += sample_frame(i, p + ivec2(x, y));
  return s / 9.0;
}

void main()
{
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  size = textureSize(f0, 0);
  if(any(greaterThanEqual(p, size))) return;

  float reference = sample_frame(0, p);
  float reference_mean = local_mean(0, p);
  // Difference of two 9-sample means of independent frames.
  float sigma2 = max(push.noise_s * max(reference_mean, 0.0) + push.noise_o, 1e-8) * (2.0 / 9.0);
  ivec2 t = min(p / push.tile, ivec2(push.tiles_x, push.tiles_y) - 1);
  int tile_index = t.y * push.tiles_x + t.x;

  float sum = reference;
  float weight = 1.0;
  [[unroll]] for(int i = 1; i < 6; i++)
  {
    if(i >= push.frames) break;
    ivec2 q = p + offsets[i * push.tiles_x * push.tiles_y + tile_index];
    float d = local_mean(i, q) - reference_mean;
    float w = push.strength * sigma2 / (push.strength * sigma2 + d * d);
    sum += w * sample_frame(i, q);
    weight += w;
  }
  float merged = clamp(sum / weight, 0.0, 1.0);
  imageStore(img_out, p, uvec4(uint(merged * 65535.0 + 0.5)));
}
