#version 450
// Flash / no-flash mix in the Bayer domain. The ambient mosaic (one raw or the merge of
// several) and a flash frame were taken at the same exposure, so the light the flash
// alone added is their difference. The output re-lights the scene:
//   out = ambient_gain * A + flash_gain * wb[colour] * max(F - A, 0)
// with wb converting the flash's colour to the ambient's white (each light balanced for
// itself). The difference is gated by a noise test on 3x3 same-colour means, so areas
// the flash did not reach add nothing rather than rectified noise; where the flash frame
// came out darker (something moved) it adds nothing either.
//
// The flash frame is registered by one similarity for the whole frame (shift, roll,
// zoom; see Warp) and read with bilinear interpolation on its own colour plane. Where
// the registration still disagrees locally (something moved between the frames), mixing
// would show the edges of both frames: a ghost. There the detail comes from the flash
// frame alone, scaled to the mix's local level. Pixels whose flash data lies outside
// the frame keep the ambient frame alone; the develop crops them away.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0) uniform usampler2D img_ambient;
layout(set = 1, binding = 1) uniform usampler2D img_flash;
layout(set = 1, binding = 2, r32ui) uniform writeonly restrict uimage2D img_out;
layout(push_constant) uniform push_t
{
  vec4  a_black;      // ambient: per 2x2 position, code values
  vec4  f_black;      // flash frame
  vec4  wb;           // flash colour -> ambient white, per colour (r g b)
  float a_white;
  float f_white;
  float ambient_gain;
  float flash_gain;
  ivec4 cfa;          // colour per 2x2 position
  float noise_s;      // variance = s x + o, x in [0, 1]
  float noise_o;
  float scale;        // output code value for 1.0
  float pad;
  vec4  warp;         // a b tx ty: q = c + [a -b; b a] (p - c) + t, c the image centre
  vec4  wbg;          // the develop's white balance multipliers per colour (r g b)
} push;

ivec2 size;

float ambient_at(ivec2 p)
{
  p = clamp(p, ivec2(p & 1), size - 2 + (p & 1)); // stay on the same CFA colour
  float b = push.a_black[(p.x & 1) + 2 * (p.y & 1)];
  return (float(texelFetch(img_ambient, p, 0).r) - b) / (push.a_white - b);
}

float flash_at(ivec2 p)
{
  p = clamp(p, ivec2(p & 1), size - 2 + (p & 1));
  float b = push.f_black[(p.x & 1) + 2 * (p.y & 1)];
  return (float(texelFetch(img_flash, p, 0).r) - b) / (push.f_white - b);
}

vec2 to_flash(vec2 p)
{
  vec2 c = 0.5 * vec2(size);
  vec2 d = p - c;
  return c + vec2(push.warp.x * d.x - push.warp.y * d.y, push.warp.y * d.x + push.warp.x * d.y) + push.warp.zw;
}

// The flash frame at a fractional position, on the colour plane of `phase`.
float flash_interp(vec2 q, ivec2 phase)
{
  vec2 u = (q - vec2(phase)) * 0.5;
  vec2 u0 = floor(u);
  vec2 w = u - u0;
  ivec2 b = ivec2(u0) * 2 + phase;
  float v00 = flash_at(b), v10 = flash_at(b + ivec2(2, 0));
  float v01 = flash_at(b + ivec2(0, 2)), v11 = flash_at(b + ivec2(2, 2));
  return mix(mix(v00, v10, w.x), mix(v01, v11, w.x), w.y);
}

float variance(float x) { return max(push.noise_s * max(x, 0.0) + push.noise_o, 1e-12); }

void main()
{
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  size = textureSize(img_ambient, 0);
  if(any(greaterThanEqual(p, size))) return;
  ivec2 phase = p & 1;
  int colour = push.cfa[phase.x + 2 * phase.y];
  float a = ambient_at(p);

  vec2 qf = to_flash(vec2(p));
  ivec2 q = ivec2(round((qf - vec2(phase)) * 0.5)) * 2 + phase; // nearest sample of this colour
  if(any(lessThan(q, ivec2(10))) || any(greaterThanEqual(q, size - 10)))
  { // no flash data here (cropped away)
    imageStore(img_out, p, uvec4(uint(clamp(push.ambient_gain * a, 0.0, 1.0) * push.scale + 0.5)));
    return;
  }
  float f = flash_interp(qf, phase);

  // Same-colour means: 3x3 (5 px wide) and 5x5 at a 4 px step (17 px wide).
  float ma = 0.0, mf = 0.0, MA = 0.0, MF = 0.0;
  for(int y = -2; y <= 2; y += 2)
    for(int x = -2; x <= 2; x += 2)
    {
      ma += ambient_at(p + ivec2(x, y));
      mf += flash_at(q + ivec2(x, y));
    }
  ma /= 9.0;
  mf /= 9.0;
  for(int y = -8; y <= 8; y += 4)
    for(int x = -8; x <= 8; x += 4)
    {
      MA += ambient_at(p + ivec2(x, y));
      MF += flash_at(q + ivec2(x, y));
    }
  MA /= 25.0;
  MF /= 25.0;

  // Is the difference above the noise of both frames?
  float sigma = sqrt(2.0 * variance(ma) / 9.0);
  float lit = smoothstep(1.0, 3.0, (mf - ma) / sigma);
  // A clipped ambient sample cannot tell what the flash added.
  if(a >= 0.98) lit = 0.0;
  float v = push.ambient_gain * a + push.flash_gain * push.wb[colour] * lit * max(f - a, 0.0);

  // Registration check. Under any light a surface keeps its local contrast: while the
  // light varies smoothly, the 5 px mean over the 17 px mean is the same in both frames.
  // Where they differ by more than the noise allows, the frames disagree here.
  float ghost = 0.0;
  if(MA > 3.0 * sqrt(variance(MA)) && MF > 3.0 * sqrt(variance(MF)))
  {
    float ra = ma / MA, rf = mf / MF;
    float sa = sqrt(variance(ma) / 9.0) / MA, sf = sqrt(variance(mf) / 9.0) / MF;
    ghost = smoothstep(3.0, 6.0, abs(ra - rf) / sqrt(sa * sa + sf * sf + 1e-8));
  }
  if(ghost > 0.0)
  { // The mix at the 17 px scale (smooth, so a few pixels of misregistration barely
    // matter) times the flash frame's own detail: one frame's edges only.
    float lit_lp = smoothstep(1.0, 3.0, (MF - MA) / sqrt(2.0 * variance(MA) / 25.0));
    float level = push.ambient_gain * MA + push.flash_gain * push.wb[colour] * lit_lp * max(MF - MA, 0.0);
    v = mix(v, level * f / MF, ghost);
  }

  // Channels clip one by one (green first): where the flash frame nears white in any
  // sample of this quad, the differences have the wrong hue. Fade the quad to a neutral
  // of the same brightness (equal after the develop's white balance).
  ivec2 q0 = q - phase, p0 = p - phase;
  float fmax = 0.0, level = 0.0;
  for(int k = 0; k < 4; k++)
  {
    ivec2 o = ivec2(k & 1, k >> 1);
    float fk = flash_at(q0 + o), ak = ambient_at(p0 + o);
    int ck = push.cfa[k];
    fmax = max(fmax, fk);
    level += (push.ambient_gain * ak + push.flash_gain * push.wb[ck] * max(fk - ak, 0.0)) * push.wbg[ck];
  }
  float clip = smoothstep(0.85, 0.97, fmax);
  v = mix(v, 0.25 * level / push.wbg[colour], clip);
  imageStore(img_out, p, uvec4(uint(clamp(v, 0.0, 1.0) * push.scale + 0.5)));
}
