#version 450
// Local tone compression of scene-linear light, ahead of the film: the large-scale
// brightness (base layer) is pulled towards mid grey, local contrast stays. The base
// is a guided filter of log2 luminance guided by itself (He et al. 2010), solved at
// low resolution and applied at full resolution, so strong edges such as a window
// frame against a dark room keep their step instead of growing halos.
//   mode 0 stats:  rgb            -> (L, L^2)          L = log2 luminance
//   mode 1 coefs:  blurred stats  -> (a, b)            a = var / (var + eps), b = (1 - a) mean
//   mode 2 apply:  rgb, blurred (a, b) -> rgb * 2^(shift), base = a L + b
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0) uniform sampler2D img_in;
layout(set = 1, binding = 1) uniform sampler2D img_coef;
layout(set = 1, binding = 2, rgba16f) uniform writeonly restrict image2D img_out;
layout(push_constant) uniform push_t
{
  int   mode;
  float strength;  // 0 keeps the base, 1 flattens it to mid grey
  float eps;       // edge threshold, variance in stops^2
  float anchor;    // log2 of the level that stays put (mid grey)
} push;

const float kMaxLift = 2.5; // stops: deep shadows are noise
const float kMaxDarken = 3.0;

float log_luminance(vec3 rgb)
{
  float y = dot(max(rgb, vec3(0.0)), vec3(0.2627, 0.6780, 0.0593)); // Rec.2020
  return log2(max(y, 1.0 / 16384.0));
}

void main()
{
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(img_out);
  if(any(greaterThanEqual(p, size))) return;
  if(push.mode == 0)
  {
    float l = log_luminance(texelFetch(img_in, p, 0).rgb);
    imageStore(img_out, p, vec4(l, l * l, 0.0, 1.0));
  }
  else if(push.mode == 1)
  {
    vec2 m = texelFetch(img_in, p, 0).xy;
    float var = max(m.y - m.x * m.x, 0.0);
    float a = var / (var + push.eps);
    imageStore(img_out, p, vec4(a, (1.0 - a) * m.x, 0.0, 1.0));
  }
  else
  {
    vec4 rgb = texelFetch(img_in, p, 0);
    vec2 ab = texture(img_coef, (vec2(p) + 0.5) / vec2(size)).xy;
    float l = log_luminance(rgb.rgb);
    float base = ab.x * l + ab.y;
    float shift = clamp(-push.strength * (base - push.anchor), -kMaxDarken, kMaxLift);
    imageStore(img_out, p, vec4(rgb.rgb * exp2(shift), rgb.a));
  }
}
