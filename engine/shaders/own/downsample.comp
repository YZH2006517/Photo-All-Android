#version 450
// Box average by an integer factor, ahead of wide blurs read back bilinearly.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0) uniform sampler2D img_in;
layout(set = 1, binding = 1, rgba16f) uniform writeonly restrict image2D img_out;
layout(push_constant) uniform push_t
{
  int factor;
} push;

void main()
{
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if(any(greaterThanEqual(p, imageSize(img_out)))) return;
  ivec2 last = textureSize(img_in, 0) - 1;
  vec4 sum = vec4(0.0);
  for(int y = 0; y < push.factor; y++)
    for(int x = 0; x < push.factor; x++)
      sum += texelFetch(img_in, min(p * push.factor + ivec2(x, y), last), 0);
  imageStore(img_out, p, sum / float(push.factor * push.factor));
}
