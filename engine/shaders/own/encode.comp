#version 450
// filmsim output (linear Rec.2020) -> 8-bit display encoding (sRGB or Display P3),
// then an optional creative 3D LUT (sRGB encoded in and out) at a given strength.
//
// Modes (lut.z):
//   0 as is: a print, a scanned slide, or an already display-referred source
//   1 neutral tone curve: scene light without film (raw sources)
//   2 negative scan: invert a scanned negative like a lab scanner, then tone curve
//   3 calibration: log2 of the linear value, dithered, for averaging on the host
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0) uniform sampler2D img_in;
layout(set = 1, binding = 1, rgba8) uniform writeonly restrict image2D img_out;
// Creative LUT as an atlas: width n (red), height n*n (green + blue * n).
layout(set = 1, binding = 2) uniform sampler2D img_lut;
layout(push_constant) uniform push_t
{
  vec4 row0;     // Rec.2020 -> output primaries, rows; w unused
  vec4 row1;
  vec4 row2;
  vec4 lut;      // x strength (0 = off), y edge size n, z mode
  vec4 mid;      // negative scan: log2 transmittance of mid grey per channel
  vec4 slope;    // log2 transmittance drop per stop of exposure, per channel
  vec4 toe;      // relative exposure (stops) of unexposed film, per channel
} push;

const float kCalibLow = -16.0, kCalibRange = 20.0;

vec3 oetf(vec3 v)
{
  return mix(v * 12.92, 1.055 * pow(v, vec3(1.0 / 2.4)) - 0.055, greaterThan(v, vec3(0.0031308)));
}

// Gentle shoulder: mid grey stays at 0.18, white reached about 4 stops above it.
vec3 tone(vec3 x)
{
  x = max(x, 0.0) * 1.2;
  return x * (1.0 + x / 16.0) / (1.0 + x);
}

// Trilinear: the sampler interpolates red and green within a blue slice, we blend slices.
vec3 creative(vec3 c)
{
  float n = push.lut.y;
  vec3 p = clamp(c, 0.0, 1.0) * (n - 1.0);
  float b0 = min(floor(p.b), n - 2.0);
  vec2 uv = vec2((p.r + 0.5) / n, (p.g + 0.5 + b0 * n) / (n * n));
  vec3 lo = textureLod(img_lut, uv, 0.0).rgb;
  vec3 hi = textureLod(img_lut, uv + vec2(0.0, 1.0 / n), 0.0).rgb;
  return mix(lo, hi, p.b - b0);
}

void main()
{
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if(any(greaterThanEqual(p, imageSize(img_out)))) return;
  vec3 rgb = texelFetch(img_in, p, 0).rgb;
  rgb = vec3(dot(push.row0.xyz, rgb), dot(push.row1.xyz, rgb), dot(push.row2.xyz, rgb));
  int mode = int(push.lut.z + 0.5);
  if(mode == 3)
  { // interleaved gradient noise as dither so the host's average resolves below one code
    float dither = fract(52.9829189 * fract(dot(vec2(p), vec2(0.06711056, 0.00583715)))) - 0.5;
    vec3 l = (log2(max(rgb, vec3(1e-6))) - kCalibLow) / kCalibRange;
    imageStore(img_out, p, vec4(clamp(l + dither / 255.0, 0.0, 1.0), 1.0));
    return;
  }
  if(mode == 2)
  { // density above mid grey -> stops of exposure; unexposed film maps to black
    vec3 stops = (push.mid.xyz - log2(max(rgb, vec3(1e-6)))) / push.slope.xyz;
    vec3 base = exp2(push.toe.xyz);
    rgb = 0.18 * (exp2(stops) - base) / (1.0 - base);
  }
  if(mode >= 1) rgb = tone(rgb);
  vec3 c = oetf(clamp(rgb, 0.0, 1.0));
  if(push.lut.x > 0.0 && push.lut.y >= 2.0) c = mix(c, creative(c), push.lut.x);
  imageStore(img_out, p, vec4(c, 1.0));
}
