#version 450
// filmsim output (linear Rec.2020) -> 8-bit display encoding (sRGB or Display P3),
// then an optional creative 3D LUT (sRGB encoded in and out) at a given strength.
//
// Modes (lut.z):
//   0 as is: a print, a scanned slide, or an already display-referred source
//   1 neutral tone curve: scene light without film (raw sources)
//   2 negative scan: invert a scanned negative like a lab scanner, then tone curve
//   3 calibration: log2 of the linear value, dithered, for averaging on the host
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0) uniform sampler2D img_in;
layout(set = 1, binding = 1, rgba8) uniform writeonly restrict image2D img_out;
// Creative LUT as an atlas: width n (red), height n*n (green + blue * n).
layout(set = 1, binding = 2) uniform sampler2D img_lut;
layout(push_constant) uniform push_t
{
  vec4 row0;     // Rec.2020 -> output primaries, rows; w unused
  vec4 row1;
  vec4 row2;
  vec4 lut;      // x strength (0 = off), y edge size n, z mode
  vec4 mid;      // negative scan: log2 transmittance of mid grey per channel; print / slide: q, m, on
  vec4 slope;    // log2 transmittance drop per stop of exposure, per channel
  vec4 toe;      // relative exposure (stops) of unexposed film, per channel
} push;

const float kCalibLow = -16.0, kCalibRange = 20.0;

vec3 oetf(vec3 v)
{
  return mix(v * 12.92, 1.055 * pow(v, vec3(1.0 / 2.4)) - 0.055, greaterThan(v, vec3(0.0031308)));
}

// A scanned negative is scene light already (inverted and calibrated per stock, mid grey at
// 0.18), so it is shown as it is for as long as the display can: straight up to 0.5
// (about a stop and a half over mid grey), then rolled off toward white, the slope
// continuous. A diffuse white (about +2.3 stops) lands near 0.77, +3 stops near 0.92, +4
// at white. The earlier curve compressed from mid grey up, flattening every highlight.
vec3 shoulder(vec3 x)
{
  x = max(x, 0.0);
  const float knee = 0.5;
  return mix(x, knee + (1.0 - knee) * (1.0 - exp(-(x - knee) / (1.0 - knee))), greaterThan(x, vec3(knee)));
}

// Display rendering for scene light without film: an S-curve like a camera's (the ACES
// fit of Narkowicz 2015), scaled so mid grey stays at 0.18. Blacks settle to black, the
// mid-tones get contrast and the highlights roll off over about four stops; a plain
// shoulder alone leaves the picture flat and grey.
vec3 tone(vec3 x)
{
  x = max(x, 0.0) * 0.72;
  return clamp(x * (2.51 * x + 0.03) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
}

// The film's output brought into the display's gamut softly instead of clipped: in OkLab
// (Ottosson 2020), lightness rolls off towards white and chroma is compressed towards the
// gamut boundary at that lightness and hue, both by one smooth knee d / (1 + d^p)^(1/p)
// over the whole range, so nothing inside changes abruptly and nothing ends up outside.
// The same kind of compression the reference spektrafilm applies at its output.
const float kKnee = 6.0;
const mat3 kRec2020ToXyzR = (mat3(0.636958, 0.144617, 0.168881, 0.262700, 0.677998, 0.059302,
                                          0.0, 0.028073, 1.060985));
const mat3 kXyzToLmsR = (mat3(0.8189330101, 0.3618667424, -0.1288597137, 0.0329845436, 0.9293118715,
                                      0.0361456387, 0.0482003018, 0.2643662691, 0.6338517070));
const mat3 kLmsToLabR = (mat3(0.2104542553, 0.7936177850, -0.0040720468, 1.9779984951, -2.4285922050,
                                      0.4505937099, 0.0259040371, 0.7827717662, -0.8086757660));
float knee(float d) { return d / pow(1.0 + pow(d, kKnee), 1.0 / kKnee); }
// the matrices above are written row by row: v * M is the matrix applied to v
vec3 to_lab(vec3 xyz)
{
  vec3 lms = xyz * kXyzToLmsR;
  return (sign(lms) * pow(abs(lms), vec3(1.0 / 3.0))) * kLmsToLabR;
}
vec3 from_lab(vec3 lab)
{
  vec3 lms = lab * inverse(kLmsToLabR);
  return (lms * lms * lms) * inverse(kXyzToLmsR);
}
vec3 gamut_compress(vec3 rgb)
{ // rgb: linear, the output primaries
  mat3 out_from_xyz = transpose(mat3(push.row0.xyz, push.row1.xyz, push.row2.xyz)) * inverse(transpose(kRec2020ToXyzR));
  vec3 lab = to_lab(inverse(out_from_xyz) * rgb);
  if(lab.x <= 0.0) return max(rgb, vec3(0.0));
  float chroma = length(lab.yz);
  vec2 hue = chroma > 1e-6 ? lab.yz / chroma : vec2(0.0);
  // lightness is left as it is up to the display's white and only what lies above it is
  // brought down to white; the roll-off toward kWhite took every white to about 0.97
  // (245 of 255), so no film output ever reached white
  float l = min(lab.x, 1.0);
  // the boundary's chroma at this lightness and hue
  float lo = 0.0, hi = 0.6;
  for(int i = 0; i < 14; i++)
  {
    float mid = 0.5 * (lo + hi);
    vec3 t = out_from_xyz * from_lab(vec3(l, hue * mid));
    if(all(greaterThanEqual(t, vec3(-1e-4))) && all(lessThanEqual(t, vec3(1.0 + 1e-4)))) lo = mid;
    else hi = mid;
  }
  float c = lo > 1e-5 ? knee(chroma / lo) * lo : 0.0;
  return max(out_from_xyz * from_lab(vec3(l, hue * c)), vec3(0.0));
}
// Trilinear: the sampler interpolates red and green within a blue slice, we blend slices.
vec3 creative(vec3 c)
{
  float n = push.lut.y;
  vec3 p = clamp(c, 0.0, 1.0) * (n - 1.0);
  float b0 = min(floor(p.b), n - 2.0);
  vec2 uv = vec2((p.r + 0.5) / n, (p.g + 0.5 + b0 * n) / (n * n));
  vec3 lo = textureLod(img_lut, uv, 0.0).rgb;
  vec3 hi = textureLod(img_lut, uv + vec2(0.0, 1.0 / n), 0.0).rgb;
  return mix(lo, hi, p.b - b0);
}

void main()
{
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if(any(greaterThanEqual(p, imageSize(img_out)))) return;
  vec3 rgb = texelFetch(img_in, p, 0).rgb;
  rgb = vec3(dot(push.row0.xyz, rgb), dot(push.row1.xyz, rgb), dot(push.row2.xyz, rgb));
  int mode = int(push.lut.z + 0.5);
  if(mode == 3)
  { // interleaved gradient noise as dither so the host's average resolves below one code
    float dither = fract(52.9829189 * fract(dot(vec2(p), vec2(0.06711056, 0.00583715)))) - 0.5;
    vec3 l = (log2(max(rgb, vec3(1e-6))) - kCalibLow) / kCalibRange;
    imageStore(img_out, p, vec4(clamp(l + dither / 255.0, 0.0, 1.0), 1.0));
    return;
  }
  if(mode == 2)
  { // density above mid grey -> stops of exposure; unexposed film maps to black
    vec3 stops = (push.mid.xyz - log2(max(rgb, vec3(1e-6)))) / push.slope.xyz;
    vec3 base = exp2(push.toe.xyz);
    rgb = 0.18 * (exp2(stops) - base) / (1.0 - base);
  }
  if(mode == 0 && push.mid.z > 0.5)
  { // a print or a slide seen against its own base: luminance mapped Y' = m Y + q (mid: q, m),
    // the colour kept (each pixel scaled by Y'/Y), as the reference's black/white correction
    float y = dot(max(rgb, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
    float y2 = max(push.mid.y * y + push.mid.x, 0.0);
    rgb = y > 1e-7 ? rgb * (y2 / y) : vec3(y2);
  }
  if(mode == 1) rgb = tone(rgb);
  else if(mode == 2) rgb = shoulder(rgb);
  if(push.lut.w > 0.5) rgb = gamut_compress(rgb);
  vec3 c = oetf(clamp(rgb, 0.0, 1.0));
  if(push.lut.x > 0.0 && push.lut.y >= 2.0) c = mix(c, creative(c), push.lut.x);
  imageStore(img_out, p, vec4(c, 1.0));
}
