#version 460
#extension GL_GOOGLE_include_directive : enable
// Adapted from vkdt denoise/downcov.comp (c) johannes hanika, BSD 2-Clause; see README.md.
// First wavelet level: anisotropic gaussian along the local structure (dn_cov.glsl),
// result written sorted into four sub-images; alpha carries an edge measure.
#include "shared.glsl"
#include "dn_cov.glsl"
layout(local_size_x = DT_LOCAL_SIZE_X, local_size_y = DT_LOCAL_SIZE_Y, local_size_z = 1) in;
layout(push_constant) uniform push_t
{
  float noise_a;
  float noise_b;
  int   level;
  int   block;
} push;
layout(set = 1, binding = 0) uniform sampler2D img_in;
layout(set = 1, binding = 1, rgba16f) uniform writeonly image2D img_out;
layout(set = 1, binding = 2, rgba16f) uniform writeonly image2D img_cov;

void main()
{
  ivec2 ipos = ivec2(gl_GlobalInvocationID);
  if(any(greaterThanEqual(ipos, imageSize(img_out)))) return;

  vec4 cov;
  vec3 rgb = response(img_in, ipos, cov, 0);
  imageStore(img_cov, ipos, cov);

  // sort image to write positions so we can iterate the filter
  ivec2 off = ivec2(ipos.x & 1, ipos.y & 1) * (imageSize(img_out) + ivec2(1)) / 2;
  ipos = ipos / 2 + off;

  float edge = clamp(75.0 * max(0.0, cov.y - 0.09), 0.0, 1.0);
  edge = smoothstep(0.4, 0.75, edge);
  edge = clamp(0.02 + edge, 0.0, 1.0);
  imageStore(img_out, ipos, vec4(rgb, edge));
}
