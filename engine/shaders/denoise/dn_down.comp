#version 460
#extension GL_GOOGLE_include_directive : enable
// Adapted from vkdt denoise/down.comp (c) johannes hanika, BSD 2-Clause; see README.md.
// Coarser wavelet levels: 5-tap "flower" filter with noise-aware edge stopping, result
// written sorted into four sub-images so the next level keeps a small support.
#include "shared.glsl"
#include "dn_noise.glsl"
layout(local_size_x = DT_LOCAL_SIZE_X, local_size_y = DT_LOCAL_SIZE_Y, local_size_z = 1) in;
layout(push_constant) uniform push_t
{
  float noise_a;
  float noise_b;
  int   level;
  int   block;
} push;
layout(set = 1, binding = 0) uniform sampler2D img_in;
layout(set = 1, binding = 1, rgba16f) uniform writeonly image2D img_out;

vec3 gamma(vec3 f)
{
  return vec3(
      f.x < 0.0 ? f.x : pow(f.x, 0.8),
      f.y < 0.0 ? f.y : pow(f.y, 0.8),
      f.z < 0.0 ? f.z : pow(f.z, 0.8));
}

vec3 edge(vec3 s, vec3 c0, vec3 c1)
{
  return clamp(1.0 - 0.5 * (s * abs(gamma(c0) - gamma(c1))), 0.0, 1.0);
}

void main()
{
  ivec2 ipos = ivec2(gl_GlobalInvocationID);
  if(any(greaterThanEqual(ipos, imageSize(img_out)))) return;

  ivec2 sz = textureSize(img_in, 0).xy;
  const float t = 0.2; // centre weight of the 5 tap flower filter
  vec3 rgb = texture(img_in, (ipos + 0.5) / vec2(sz)).rgb;
  vec3 sum = t * rgb;
  vec3 wgt = vec3(t);
  const float block = push.block == 2 ? 1.414213 : 1.0;
  const vec3 sigma = pow(0.7, push.level) * noise_sigma(push.noise_a, push.noise_b, rgb.r) / block;
  vec3 wc = vec3(1.0 / sigma);
#define lookup(O) \
  do { \
    vec3 col = texture(img_in, (ipos + O) / vec2(sz)).rgb; \
    vec3 w = edge(wc, col, rgb) * (1.0 - t) / 4.0; \
    sum += w * col; \
    wgt += w; \
  } while(false)
  lookup(vec2(0.5 + 1.2, 0.5 + 0.4));
  lookup(vec2(0.5 - 1.2, 0.5 - 0.4));
  lookup(vec2(0.5 + 0.4, 0.5 - 1.2));
  lookup(vec2(0.5 - 0.4, 0.5 + 1.2));
#undef lookup
  rgb = sum / wgt;

  // sort image to write positions so we can iterate the filter
  ivec2 off = ivec2(ipos.x & 1, ipos.y & 1) * (imageSize(img_out) + ivec2(1)) / 2;
  ipos = ipos / 2 + off;
  imageStore(img_out, ipos, vec4(rgb, 1));
}
