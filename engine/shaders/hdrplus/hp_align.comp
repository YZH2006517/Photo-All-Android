#version 450
// SPDX-License-Identifier: GPL-3.0-or-later
// Burst merge (HDR+), alignment at one pyramid level: one workgroup per tile. Tiles of
// `tile` pixels overlap by half. The coarser level's vector, scaled up, and those of
// two neighbouring tiles are tried first (better at the edges of moving things), then
// +-`search` pixels (at most 2) around the best. L2 on the coarse levels, L1 at the finest, as in
// Hasinoff et al. 2016. Adapted from correct_upsampling_error,
// compute_tile_differences25 and find_best_tile_alignment of hdr-plus-swift (GPL-3.0);
// here the tile and its search window are loaded into shared memory and the 64
// threads of the workgroup share its pixels, the sums reduced in shared memory.
// No subgroup operations and no local arrays: Mali's compiler (vivo, MediaTek MT6993,
// Android 17) crashed on the earlier form, a float[25] reduced with subgroupAdd.
layout(local_size_x = 64) in;
layout(set = 1, binding = 0) uniform sampler2D img_ref;
layout(set = 1, binding = 1) uniform sampler2D img_comp;
layout(set = 1, binding = 2) uniform sampler2D img_prev;  // coarser level's vectors (xy)
layout(set = 1, binding = 3, rgba16f) uniform writeonly restrict image2D img_out;
layout(push_constant) uniform push_t
{
  int tile;       // 8, 16 or 32
  int search;     // 1 or 2
  int has_prev;   // 0 at the coarsest level
  int ssd;        // 1: squared differences; 2 and up: also every ssd/2-th pixel only
  ivec2 tiles;    // this level
  ivec2 prev_tiles;
} push;

const int kMaxTile = 32;
const int kWin = kMaxTile + 4;
const float kOutside = -4.0; // a comparison pixel outside the frame: never matches

shared float s_ref[kMaxTile * kMaxTile];
shared float s_comp[kWin * kWin];
shared float s_acc[25 * 64]; // [candidate * 64 + thread]: each thread's partial sum
shared float s_total[25];
uint t;
ivec2 size;

float err(float r, float c)
{
  float e = abs(r - c);
  return push.ssd == 1 ? e * e : e;
}

// The tile's pixels that enter the costs: all, or every `step`-th each way (the finest
// level, where a tile has 1024 pixels and a quarter of them decide as well).
int step()
{
  return push.ssd >= 2 ? push.ssd / 2 : 1;
}

float comp_at(ivec2 q)
{
  return any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size)) ? kOutside : texelFetch(img_comp, q, 0).r;
}

// The sums of s_acc over the threads, for candidates 0..n-1, into s_total.
void reduce(int n)
{
  barrier();
  if(int(t) < n)
  {
    float total = 0.0;
    for(int i = 0; i < 64; i++) total += s_acc[int(t) * 64 + i];
    s_total[t] = total;
  }
  barrier();
}

ivec2 previous(ivec2 tl)
{
  tl = clamp(tl, ivec2(0), push.tiles - 1);
  ivec2 c = clamp(ivec2((vec2(tl) + 0.5) * vec2(push.prev_tiles) / vec2(push.tiles)), ivec2(0), push.prev_tiles - 1);
  return 2 * ivec2(round(texelFetch(img_prev, c, 0).xy));
}

void main()
{
  t = gl_LocalInvocationIndex;
  size = textureSize(img_ref, 0);
  ivec2 tl = ivec2(gl_WorkGroupID.xy);
  ivec2 origin = tl * (push.tile / 2);
  int n = push.tile * push.tile;
  for(int i = int(t); i < n; i += 64)
    s_ref[i] = texelFetch(img_ref, clamp(origin + ivec2(i % push.tile, i / push.tile), ivec2(0), size - 1), 0).r;
  barrier();

  ivec2 base = ivec2(0);
  if(push.has_prev == 1)
  {
    ivec2 c[3];
    c[0] = previous(tl);
    c[1] = previous(tl + ivec2((tl.x & 1) == 0 ? -1 : 1, 0));
    c[2] = previous(tl + ivec2(0, (tl.y & 1) == 0 ? -1 : 1));
    int st = step(), side_n = push.tile / st;
    for(int k = 0; k < 3; k++)
    {
      float sum = 0.0;
      for(int j = int(t); j < side_n * side_n; j += 64)
      {
        int x = (j % side_n) * st, y = (j / side_n) * st;
        sum += err(s_ref[y * push.tile + x], comp_at(origin + ivec2(x, y) + c[k]));
      }
      s_acc[k * 64 + int(t)] = sum;
    }
    reduce(3);
    float d0 = s_total[0], d1 = s_total[1], d2 = s_total[2];
    base = d0 <= d1 && d0 <= d2 ? c[0] : d1 <= d2 ? c[1] : c[2];
    barrier();
  }

  // The search window: the tile moved by `base`, widened by `search` on every side.
  int r = push.search, side = 2 * r + 1, count = side * side;
  int win = push.tile + 2 * r;
  for(int i = int(t); i < win * win; i += 64)
    s_comp[i] = comp_at(origin + base + ivec2(i % win - r, i / win - r));
  barrier();
  int st = step(), side_n = push.tile / st;
  for(int k = 0; k < count; k++)
  {
    int dx = k % side, dy = k / side;
    float sum = 0.0;
    for(int j = int(t); j < side_n * side_n; j += 64)
    {
      int x = (j % side_n) * st, y = (j / side_n) * st;
      sum += err(s_ref[y * push.tile + x], s_comp[(y + dy) * win + x + dx]);
    }
    s_acc[k * 64 + int(t)] = sum;
  }
  reduce(count);
  if(t == 0u)
  {
    int best = 0;
    for(int k = 1; k < count; k++)
      if(s_total[k] < s_total[best]) best = k;
    ivec2 found = base + ivec2(best % side - r, best / side - r);
    imageStore(img_out, tl, vec4(vec2(found), 0.0, 1.0));
  }
}
