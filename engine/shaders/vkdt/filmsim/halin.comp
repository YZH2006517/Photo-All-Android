#version 460
#extension GL_GOOGLE_include_directive    : enable
#include "head.glsl"
#include "state.glsl"
layout(set = 1, binding = 0) uniform sampler2D img_in;
layout(set = 1, binding = 1, std430) readonly buffer buf_prep_t { filmsim_state_t prep; };
layout(set = 1, binding = 2, rgba16f) uniform writeonly restrict image2D img_out;
#include "state_ops.glsl"
#include "sampling.glsl"

void main()
{
  FILMSIM_BOUNDS_INIT(ipos);
  // the light as it reached the emulsion: halation and scatter are the exposure's, before
  // development (the inhibitors come off after them, in halout), as the reference orders it
  ivec2 out_sz = imageSize(img_out);
  vec3 log_raw = fetch_upsampled(img_in, ipos, (ipos + 0.5) / vec2(out_sz));
  vec3 raw = exp2(log_raw * log2_10);
  imageStore(img_out, ipos, vec4(raw, 1));
}
